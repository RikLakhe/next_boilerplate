    "class-validator": "^0.14.1",
    "dayjs": "^1.11.9",
    "formik": "^2.4.1",
    "framer-motion": "^12.10.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "9.0.0",
    "jspdf": "^3.0.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "motion": "^12.10.0",
    "mrz": "^4.0.0",
    "next": "15.3.1",
    "next-auth": "^4.24.11",
