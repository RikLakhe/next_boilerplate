{
  "name": "ams-fullstack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-path .gitignore --ignore-path .eslintignore --ext .ts src/",
    "lint:fix": "eslint --ignore-path .gitignore --ignore-path .eslintignore --ext .ts src/ --fix .",
    "deploy": "dotenv -e .env.prod next build",
    "prepare": "husky install",
    "prettify": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "dev:clean": "rm -rf .next && npm run dev",
    "db:reset": "npm run prisma:reset && npm run prisma:seed",
    "prisma": "prisma",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:db-pull": "prisma db pull",
    "prisma:db-push": "prisma db push",
    "prisma:reset": "prisma migrate reset --force",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
