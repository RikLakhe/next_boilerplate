generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model areas {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique(map: "areas_name_unique") @db.VarChar(100)
  description        String?
  created_by         Int?
  created_on         DateTime             @default(now()) @db.Timestamptz(6)
  updated_by         Int?
  updated_on         DateTime?            @db.Timestamptz(6)
  user_state_history user_state_history[]
  users              users[]

  @@index([name], map: "idx_areas_name")
}

model audit_logs {
  id                                   Int          @id @default(autoincrement())
  entity                               String?      @db.VarChar(255)
  old_value                            Json?        @db.Json
  new_value                            Json?        @db.Json
  request_type                         requesttype?
  requested_by                         Int?
  requested_on                         DateTime?    @default(now()) @db.Timestamptz(6)
  responded_by                         Int?
  responded_on                         DateTime?    @db.Timestamptz(6)
  users_audit_logs_requested_byTousers users?       @relation("audit_logs_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_audit_logs_responded_byTousers users?       @relation("audit_logs_responded_byTousers", fields: [responded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model designations {
  id                 Int                  @id @default(autoincrement())
  title              String               @unique(map: "designations_title_unique") @db.VarChar(100)
  description        String?
  created_by         Int?
  created_on         DateTime             @default(now()) @db.Timestamptz(6)
  updated_by         Int?
  updated_on         DateTime?            @db.Timestamptz(6)
  user_state_history user_state_history[]
  users              users[]

  @@index([title], map: "idx_designations_title")
}

model employment_statuses {
  id                 Int                  @id @default(autoincrement())
  status_name        String               @unique(map: "employment_statuses_status_name_unique") @db.VarChar(50)
  description        String?
  created_by         Int?
  created_on         DateTime             @default(now()) @db.Timestamptz(6)
  updated_by         Int?
  updated_on         DateTime?            @db.Timestamptz(6)
  user_state_history user_state_history[]
  users              users[]

  @@index([status_name], map: "idx_employment_statuses_status_name")
}

model user_state_history {
  id                                         Int                 @id @default(autoincrement())
  user_id                                    Int
  area_id                                    Int
  designation_id                             Int
  employment_status_id                       Int
  start_date                                 DateTime            @db.Date
  end_date                                   DateTime?           @db.Date
  created_by                                 Int?
  created_on                                 DateTime?           @default(now()) @db.Timestamptz(6)
  updated_by                                 Int?
  updated_on                                 DateTime?           @db.Timestamptz(6)
  areas                                      areas               @relation(fields: [area_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_user_state_history_created_byTousers users?              @relation("user_state_history_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designations                               designations        @relation(fields: [designation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employment_statuses                        employment_statuses @relation(fields: [employment_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_user_state_history_updated_byTousers users?              @relation("user_state_history_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_user_state_history_user_idTousers    users               @relation("user_state_history_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([area_id], map: "idx_user_state_history_area_id")
  @@index([designation_id], map: "idx_user_state_history_designation_id")
  @@index([employment_status_id], map: "idx_user_state_history_employment_status_id")
  @@index([user_id], map: "idx_user_state_history_user_id")
  @@index([user_id, end_date], map: "idx_user_state_history_user_id_end_date")
  @@index([user_id, start_date], map: "idx_user_state_history_user_id_start_date")
}

model users {
  id                                                      Int                  @id @default(autoincrement())
  full_name                                               String               @db.VarChar
  email                                                   String               @unique(map: "users_email_unique") @db.VarChar
  password_hash                                           String               @db.VarChar
  manager_id                                              Int?
  current_area_id                                         Int?
  current_designation_id                                  Int?
  current_employment_status_id                            Int
  created_by                                              Int?
  created_on                                              DateTime             @default(now()) @db.Timestamptz(6)
  updated_by                                              Int?
  updated_on                                              DateTime?            @db.Timestamptz(6)
  audit_logs_audit_logs_requested_byTousers               audit_logs[]         @relation("audit_logs_requested_byTousers")
  audit_logs_audit_logs_responded_byTousers               audit_logs[]         @relation("audit_logs_responded_byTousers")
  events_events_created_byTousers                         events[]             @relation("events_created_byTousers")
  events_events_updated_byTousers                         events[]             @relation("events_updated_byTousers")
  holidays_holidays_created_byTousers                     holidays[]           @relation("holidays_created_byTousers")
  holidays_holidays_updated_byTousers                     holidays[]           @relation("holidays_updated_byTousers")
  notices_notices_created_byTousers                       notices[]            @relation("notices_created_byTousers")
  notices_notices_updated_byTousers                       notices[]            @relation("notices_updated_byTousers")
  team_allocations_team_allocations_created_byTousers     team_allocations[]   @relation("team_allocations_created_byTousers")
  team_allocations_team_allocations_updated_byTousers     team_allocations[]   @relation("team_allocations_updated_byTousers")
  team_allocations_team_allocations_user_idTousers        team_allocations[]   @relation("team_allocations_user_idTousers")
  teams_teams_created_byTousers                           teams[]              @relation("teams_created_byTousers")
  teams_teams_lead_user_idTousers                         teams[]              @relation("teams_lead_user_idTousers")
  teams_teams_updated_byTousers                           teams[]              @relation("teams_updated_byTousers")
  user_state_history_user_state_history_created_byTousers user_state_history[] @relation("user_state_history_created_byTousers")
  user_state_history_user_state_history_updated_byTousers user_state_history[] @relation("user_state_history_updated_byTousers")
  user_state_history_user_state_history_user_idTousers    user_state_history[] @relation("user_state_history_user_idTousers")
  areas                                                   areas?               @relation(fields: [current_area_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  designations                                            designations?        @relation(fields: [current_designation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employment_statuses                                     employment_statuses  @relation(fields: [current_employment_status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                                   users?               @relation("usersTousers", fields: [manager_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_users                                             users[]              @relation("usersTousers")

  @@index([current_area_id], map: "idx_users_current_area_id")
  @@index([current_designation_id], map: "idx_users_current_designation_id")
  @@index([current_employment_status_id], map: "idx_users_current_employment_status_id")
  @@index([email], map: "idx_users_email")
  @@index([manager_id], map: "idx_users_manager_id")
}

model team_allocations {
  id                                       Int       @id @default(autoincrement())
  user_id                                  Int
  team_id                                  Int
  role_in_team                             String?   @db.VarChar(100)
  start_date                               DateTime  @db.Date
  end_date                                 DateTime? @db.Date
  allocation_percentage                    Decimal?  @default(100.00) @db.Decimal(5, 2)
  created_by                               Int?
  created_on                               DateTime  @default(now()) @db.Timestamptz(6)
  updated_by                               Int?
  updated_on                               DateTime? @db.Timestamptz(6)
  users_team_allocations_created_byTousers users?    @relation("team_allocations_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teams                                    teams     @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_team_allocations_updated_byTousers users?    @relation("team_allocations_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_team_allocations_user_idTousers    users     @relation("team_allocations_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([team_id], map: "idx_team_allocations_team_id")
  @@index([user_id], map: "idx_team_allocations_user_id")
  @@index([user_id, team_id, start_date], map: "idx_team_allocations_user_id_team_id_start_date")
}

model teams {
  id                              Int                @id @default(autoincrement())
  name                            String             @unique(map: "teams_name_unique") @db.VarChar(100)
  description                     String?
  lead_user_id                    Int?
  created_by                      Int?
  created_on                      DateTime           @default(now()) @db.Timestamptz(6)
  updated_by                      Int?
  updated_on                      DateTime?          @db.Timestamptz(6)
  team_allocations                team_allocations[]
  users_teams_created_byTousers   users?             @relation("teams_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_teams_lead_user_idTousers users?             @relation("teams_lead_user_idTousers", fields: [lead_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_teams_updated_byTousers   users?             @relation("teams_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([lead_user_id], map: "idx_teams_lead_user_id")
  @@index([name], map: "idx_teams_name")
}

model events {
  id                             Int       @id @default(autoincrement())
  title                          String?   @db.VarChar(255)
  start_date                     DateTime? @db.Date
  end_date                       DateTime? @db.Date
  description                    String?
  is_all_day                     Boolean?  @default(true)
  is_recurring                   Boolean?  @default(false)
  recurrence_pattern             String?   @db.VarChar(50)
  visibility_scope               String?   @default("company") @db.VarChar(50)
  is_active                      Boolean?  @default(true)
  is_deleted                     Boolean?  @default(false)
  created_by                     Int?
  created_on                     DateTime  @default(now()) @db.Timestamptz(6)
  updated_by                     Int?
  updated_on                     DateTime? @db.Timestamptz(6)
  event_type_code                String?   @db.VarChar(50)
  users_events_created_byTousers users?    @relation("events_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_events_updated_byTousers users?    @relation("events_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model holidays {
  id                               Int       @id @default(autoincrement())
  title                            String?   @db.VarChar(255)
  start_date                       DateTime? @db.Date
  end_date                         DateTime? @db.Date
  description                      String?
  country_code                     String?   @db.Char(2)
  region                           String?   @db.VarChar(100)
  is_active                        Boolean?  @default(true)
  is_deleted                       Boolean?  @default(false)
  created_by                       Int?
  created_on                       DateTime  @default(now()) @db.Timestamptz(6)
  updated_by                       Int?
  updated_on                       DateTime? @db.Timestamptz(6)
  holiday_type_code                String?   @db.VarChar(50)
  users_holidays_created_byTousers users?    @relation("holidays_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_holidays_updated_byTousers users?    @relation("holidays_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model notices {
  id                              Int       @id @default(autoincrement())
  title                           String?   @db.VarChar(255)
  start_date                      DateTime? @db.Date
  end_date                        DateTime? @db.Date
  description                     String?
  target_audience                 String?   @db.VarChar(100)
  is_active                       Boolean?  @default(true)
  is_deleted                      Boolean?  @default(false)
  created_by                      Int?
  created_on                      DateTime  @default(now()) @db.Timestamptz(6)
  updated_by                      Int?
  updated_on                      DateTime? @db.Timestamptz(6)
  notice_type_code                String?   @db.VarChar(50)
  urgency_type_code               String?   @db.VarChar(50)
  users_notices_created_byTousers users?    @relation("notices_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_notices_updated_byTousers users?    @relation("notices_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model master_data {
  id          Int      @id @default(autoincrement())
  entity_type String   @db.VarChar(50)
  code        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(255)
  color       String?  @db.VarChar(20)
  is_active   Boolean? @default(true)

  @@unique([entity_type, code], map: "idx_master_data_entity_type_code")
  @@index([entity_type], map: "idx_master_data_entity_type")
}

enum requesttype {
  CREATE
  UPDATE
  DELETE
  OTHER
}
